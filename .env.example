# Loggy3 Bot – Environment Configuration
# Copy this file to .env and fill in your values.

# =============================================================================
# WINDOW TITLES  (partial match, case-insensitive)
# =============================================================================
# The Loggy3 app title bar shows "Loggy3"
RECORDER_APP_TITLE=Loggy3

# The YouTube web-app window title contains "YouTube"
BROWSER_WINDOW_TITLE=YouTube

# =============================================================================
# BUTTON COORDINATES  – NOT USED
# Image recognition finds buttons automatically. Leave these at 0.
# =============================================================================
START_BUTTON_X=0
START_BUTTON_Y=0
STOP_BUTTON_X=0
STOP_BUTTON_Y=0
MINIMIZE_BUTTON_X=0
MINIMIZE_BUTTON_Y=0

# =============================================================================
# DISPLAY SETTINGS
# =============================================================================
# Set to your actual screen resolution (check Display Settings on Windows)
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# DPI scaling: 1.0 = 100%, 1.25 = 125%, 1.5 = 150%, 2.0 = 200%
# On Windows: Settings → Display → Scale
DPI_SCALE=1.0

PRIMARY_MONITOR=0
